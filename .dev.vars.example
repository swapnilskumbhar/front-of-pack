# Public OpenNext Worker webhook secrets. Copy to .dev.vars; never commit real values.
WHATSAPP_VERIFY_TOKEN="replace-with-random-verification-token"
WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
PROFILE_HMAC_SECRET="replace-with-random-profile-hmac-secret"
DELIVERY_ENCRYPTION_KEY="replace-with-the-same-base64-encoded-32-byte-key-as-jobs"
OFFICER_DEMO_USER="replace-with-demo-officer-username"
OFFICER_DEMO_PASS="replace-with-long-random-demo-password"
OFFICER_SESSION_SECRET="replace-with-random-session-signing-secret"
