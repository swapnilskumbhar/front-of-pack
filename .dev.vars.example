# Public OpenNext Worker local-secret template.
# No public-Worker secret is required during the current local foundation phase.
# Never place OPENAI_API_KEY here; it belongs only in workers/jobs/.dev.vars.
# Copy this file to .dev.vars only when testing the WhatsApp webhook locally.
WHATSAPP_VERIFY_TOKEN="replace-with-a-random-verification-token"
WHATSAPP_APP_SECRET="replace-with-your-meta-app-secret"
