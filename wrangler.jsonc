{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "front-of-pack",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Production D1 ID; Wrangler still simulates it locally unless remote mode is requested.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "front-of-pack",
      "database_id": "7b69f749-7449-4155-ae96-58c15c413a56",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "front-of-pack-private-media",
      "preview_bucket_name": "front-of-pack-private-media-preview"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "front-of-pack-analysis"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
