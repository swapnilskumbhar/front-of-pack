{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "front-of-pack-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,

  // Production D1 ID; Wrangler still simulates it locally unless remote mode is requested.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "front-of-pack",
      "database_id": "7b69f749-7449-4155-ae96-58c15c413a56",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "front-of-pack-private-media",
      "preview_bucket_name": "front-of-pack-private-media-preview"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },

  // Local placeholder bindings only. Replace queue IDs/configuration after the
  // production Cloudflare resources are provisioned.
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "front-of-pack-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "front-of-pack-analysis",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "dead_letter_queue": "front-of-pack-analysis-dlq"
      },
      {
        "queue": "front-of-pack-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "front-of-pack-delivery-dlq"
      }
    ]
  },

  // Do not copy OPENAI_API_KEY or Meta send credentials into the public Worker.
  "vars": {
    "ENVIRONMENT": "production",
    "MODEL_ANALYSIS": "gpt-5.6-terra",
    "TERRA_REASONING_EFFORT": "low",
    "WHATSAPP_GRAPH_VERSION": "v23.0"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
